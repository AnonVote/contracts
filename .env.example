# Stellar admin secret key for contract deployment
STELLAR_SECRET_KEY=your-secret-key

# Stellar RPC endpoint (defaults are set per network in deploy.sh)
# testnet default: https://soroban-testnet.stellar.org
# mainnet default: https://soroban-mainnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
