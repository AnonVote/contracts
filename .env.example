# Stellar admin secret key for contract deployment / service calls
STELLAR_SECRET_KEY=your-secret-key

# Deployed Soroban contract ID — set this after running ./deploy.sh testnet
# Format: C followed by 55 uppercase alphanumeric characters
# Example: SOROBAN_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SOROBAN_CONTRACT_ID=

# Soroban RPC endpoints (optional — defaults are set by createDefaultTestnetConfig
# and createDefaultMainnetConfig helpers, but can be overridden here for custom
# RPC gateways, local dev nodes, or future networks).
# SOROBAN_RPC_URL_TESTNET=https://soroban-testnet.stellar.org
# SOROBAN_RPC_URL_MAINNET=https://soroban-mainnet.stellar.org
